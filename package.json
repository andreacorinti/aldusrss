{
  "name": "aldusrss",
  "private": true,
  "version": "0.4.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:bundle:release": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:release": "node scripts/bump-android-release.mjs",
    "linux:appimage": "npm run build && electron-builder --linux AppImage"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.andreacorinti.aldusrss",
    "productName": "AldusRSS",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "dist/**/*"],
    "linux": {
      "target": "AppImage",
      "icon": "electron/icon.png",
      "category": "News"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
